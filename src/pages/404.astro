---
import Layout from "../layout/Layout.astro";
---

<Layout title="404 - Page Not Found" description="Page Not Found">
  <main class="flex h-screen flex-col items-center justify-center gap-6">
    <h1 class="text-3xl">404 - Page Not Found</h1>
    <a
      href="/"
      class="group bg-slate-600 text-slate-100 border-transparent px-8 py-2 mt-4 rounded-xl min-w-44 hover:bg-white hover:text-slate-600 hover:border-slate-600 border-2 transition-colors flex items-center justify-center gap-2"
      ><span class="inline-block group-hover:-translate-x-1 transition-transform duration-200 ease-out">&larr;</span> Go Back</a
    >
  </main>
</Layout>
